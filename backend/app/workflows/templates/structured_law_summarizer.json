{
  "schema_version": 1,
  "nodes": [
    {
      "id": "document_input",
      "kind": "document_input",
      "name": "Law document input",
      "description": "The statutory text file or full law text to be analyzed.",
      "position": {
        "x": 40,
        "y": 200
      },
      "config": {
        "source_policy": "campaign_source"
      }
    },
    {
      "id": "section_breakdown_analysis",
      "kind": "llm",
      "name": "1. Section breakdown & taxonomy (BillSum Stage 1)",
      "description": "Decompose legislative text into structural units (Titles, Sections, Amendments, Definitions).",
      "position": {
        "x": 350,
        "y": 200
      },
      "config": {
        "document_context": "source_text",
        "instructions": "Decompose the legal statute into key structural components. Identify: 1) Major Titles & Sections, 2) Core Legal Categories (Scope/Definitions, Regulatory Mandate, Private Right of Action, Appropriations/Funding, Enforcement/Penalties, Statutory Amendments). Return a structured list of key sections and structural taxonomy.",
        "input_fields": [],
        "outputs": [
          {
            "key": "major_statutory_sections",
            "label": "Major statutory sections",
            "type": "list[string]",
            "required": true
          },
          {
            "key": "legal_taxonomy_categories",
            "label": "Legal taxonomy categories",
            "type": "list[string]",
            "required": true
          }
        ]
      }
    },
    {
      "id": "crs_provisions_analysis",
      "kind": "llm",
      "name": "2. CRS statutory modifications & provisions (BillSum Stage 2)",
      "description": "Extract short title, U.S. Code amendments, effective dates, and penalty tiers.",
      "position": {
        "x": 700,
        "y": 200
      },
      "config": {
        "document_context": "source_text",
        "instructions": "Extract standard Congressional Research Service (CRS) statutory fields: 1) Official Short Title & Legislative Purpose, 2) Existing U.S. Code chapters/sections modified or amended, 3) Effective dates and phase-in timeline, 4) Enforcement mechanisms, civil/criminal penalties, and liability tiers.",
        "input_fields": [
          "section_breakdown_analysis.major_statutory_sections",
          "section_breakdown_analysis.legal_taxonomy_categories"
        ],
        "outputs": [
          {
            "key": "short_title_and_purpose",
            "label": "Short title & purpose",
            "type": "string",
            "required": true
          },
          {
            "key": "amended_us_code_sections",
            "label": "Amended U.S. Code sections",
            "type": "list[string]",
            "required": false
          },
          {
            "key": "effective_timeline",
            "label": "Effective dates & timeline",
            "type": "string",
            "required": false
          },
          {
            "key": "penalties_and_enforcement",
            "label": "Penalties & enforcement",
            "type": "list[string]",
            "required": false
          }
        ]
      }
    },
    {
      "id": "administrative_delegation_analysis",
      "kind": "llm",
      "name": "3. Administrative delegation & policy impact (BillSum Stage 3)",
      "description": "Identify delegated executive agencies, rulemaking scope, and reporting burdens.",
      "position": {
        "x": 1050,
        "y": 200
      },
      "config": {
        "document_context": "source_text",
        "instructions": "Analyze administrative delegation and regulatory impact: 1) Federal executive agencies receiving authority, 2) Discretionary rulemaking and standard-setting powers granted, 3) Reporting deadlines, consultation mandates, and statutory constraints imposed on administrative actors.",
        "input_fields": [
          "crs_provisions_analysis.short_title_and_purpose",
          "crs_provisions_analysis.amended_us_code_sections"
        ],
        "outputs": [
          {
            "key": "administrative_actors",
            "label": "Administrative actors & agencies",
            "type": "list[string]",
            "required": true
          },
          {
            "key": "delegated_rulemaking_powers",
            "label": "Delegated rulemaking powers",
            "type": "list[string]",
            "required": true
          },
          {
            "key": "statutory_constraints",
            "label": "Statutory constraints & oversight",
            "type": "list[string]",
            "required": false
          }
        ]
      }
    },
    {
      "id": "executive_crs_synthesis",
      "kind": "llm",
      "name": "4. Executive CRS legal synthesis (BillSum Digest)",
      "description": "Assemble a standardized CRS-style Markdown legal digest with headers.",
      "position": {
        "x": 1400,
        "y": 200
      },
      "config": {
        "document_context": "source_text",
        "instructions": "Synthesize all extracted findings into a comprehensive Congressional Research Service (CRS) style structured legal digest markdown. Include clean headers: # Executive Summary, ## Major Statutory Sections & Taxonomy, ## Core Provisions & Statutory Modifications, ## Administrative Delegation & Constraints, ## Penalties, Enforcement & Effective Timeline.",
        "input_fields": [
          "section_breakdown_analysis.major_statutory_sections",
          "crs_provisions_analysis.short_title_and_purpose",
          "crs_provisions_analysis.amended_us_code_sections",
          "crs_provisions_analysis.effective_timeline",
          "crs_provisions_analysis.penalties_and_enforcement",
          "administrative_delegation_analysis.administrative_actors",
          "administrative_delegation_analysis.delegated_rulemaking_powers",
          "administrative_delegation_analysis.statutory_constraints"
        ],
        "outputs": [
          {
            "key": "structured_crs_summary_markdown",
            "label": "Structured CRS summary markdown",
            "type": "string",
            "required": true
          }
        ]
      }
    },
    {
      "id": "dashboard_output",
      "kind": "output",
      "name": "Database Storage & Dashboard Output",
      "description": "Automatically persists all extracted fields into PostgreSQL/SQLite (dashboard_documents.coded_values) and renders them on your Campaign Dashboard.",
      "position": {
        "x": 1750,
        "y": 200
      },
      "config": {
        "auto_save_to_db": true,
        "storage_target": "dashboard_documents.coded_values",
        "fields": [
          {
            "key": "short_title_and_purpose",
            "field": "crs_provisions_analysis.short_title_and_purpose"
          },
          {
            "key": "major_statutory_sections",
            "field": "section_breakdown_analysis.major_statutory_sections"
          },
          {
            "key": "amended_us_code_sections",
            "field": "crs_provisions_analysis.amended_us_code_sections"
          },
          {
            "key": "administrative_actors",
            "field": "administrative_delegation_analysis.administrative_actors"
          },
          {
            "key": "delegated_rulemaking_powers",
            "field": "administrative_delegation_analysis.delegated_rulemaking_powers"
          },
          {
            "key": "statutory_constraints",
            "field": "administrative_delegation_analysis.statutory_constraints"
          },
          {
            "key": "effective_timeline",
            "field": "crs_provisions_analysis.effective_timeline"
          },
          {
            "key": "penalties_and_enforcement",
            "field": "crs_provisions_analysis.penalties_and_enforcement"
          },
          {
            "key": "structured_crs_summary_markdown",
            "field": "executive_crs_synthesis.structured_crs_summary_markdown"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "document_input",
      "target": "section_breakdown_analysis"
    },
    {
      "id": "e2",
      "source": "section_breakdown_analysis",
      "target": "crs_provisions_analysis"
    },
    {
      "id": "e3",
      "source": "crs_provisions_analysis",
      "target": "administrative_delegation_analysis"
    },
    {
      "id": "e4",
      "source": "administrative_delegation_analysis",
      "target": "executive_crs_synthesis"
    },
    {
      "id": "e5",
      "source": "executive_crs_synthesis",
      "target": "dashboard_output"
    }
  ],
  "outputs": [
    {
      "key": "short_title_and_purpose",
      "source": "crs_provisions_analysis.short_title_and_purpose",
      "group": "Summary"
    },
    {
      "key": "major_statutory_sections",
      "source": "section_breakdown_analysis.major_statutory_sections",
      "group": "Structure"
    },
    {
      "key": "amended_us_code_sections",
      "source": "crs_provisions_analysis.amended_us_code_sections",
      "group": "Statute Modifications"
    },
    {
      "key": "administrative_actors",
      "source": "administrative_delegation_analysis.administrative_actors",
      "group": "Delegation"
    },
    {
      "key": "delegated_rulemaking_powers",
      "source": "administrative_delegation_analysis.delegated_rulemaking_powers",
      "group": "Delegation"
    },
    {
      "key": "statutory_constraints",
      "source": "administrative_delegation_analysis.statutory_constraints",
      "group": "Delegation"
    },
    {
      "key": "effective_timeline",
      "source": "crs_provisions_analysis.effective_timeline",
      "group": "Compliance"
    },
    {
      "key": "penalties_and_enforcement",
      "source": "crs_provisions_analysis.penalties_and_enforcement",
      "group": "Compliance"
    },
    {
      "key": "structured_crs_summary_markdown",
      "source": "executive_crs_synthesis.structured_crs_summary_markdown",
      "group": "Summary"
    }
  ]
}
